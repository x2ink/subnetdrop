#!/usr/bin/env bash

# Ensure UTF-8 locale for correct Chinese/multibyte input handling
export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# Pass through: amend, merge, squash, already-formatted messages
if [ "$COMMIT_SOURCE" = "commit" ] || [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "squash" ]; then
    exit 0
fi

if grep -qE "^(feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert)(\([a-zA-Z0-9_,/-]+\))?: .+" "$COMMIT_MSG_FILE"; then
    exit 0
fi

# Block git commit -m with non-conforming message
if [ -f "$COMMIT_MSG_FILE" ] && grep -q "^[^#]" "$COMMIT_MSG_FILE"; then
    : > "$COMMIT_MSG_FILE"
    echo -e "\033[1;31m错误：请勿使用 'git commit -m' 提交不符合规范的信息。\033[0m" >&2
    echo -e "\033[1;32m请使用 'git commit' 进行交互式提交。\033[0m" >&2
    exit 1
fi

exec < /dev/tty

# Abort commit cleanly on Ctrl+C or Ctrl+D
trap 'echo "" >&2; echo "已取消提交。" >&2; exit 1' INT TERM HUP

select_type() {
    echo "" >&2
    echo "请选择提交类型（Ctrl+C 取消）：" >&2
    local options=(
        "feat     - 新功能"
        "fix      - Bug 修复"
        "docs     - 文档变更"
        "style    - 代码格式（不影响逻辑）"
        "refactor - 代码重构"
        "perf     - 性能优化"
        "test     - 测试相关"
        "chore    - 构建/工具链"
    )
    PS3="请输入数字选择类型 [1-8]："
    select _ in "${options[@]}"; do
        case $REPLY in
            1) echo "feat"; break ;;
            2) echo "fix"; break ;;
            3) echo "docs"; break ;;
            4) echo "style"; break ;;
            5) echo "refactor"; break ;;
            6) echo "perf"; break ;;
            7) echo "test"; break ;;
            8) echo "chore"; break ;;
            "") echo "" >&2; echo "已取消提交。" >&2; exit 1 ;;
            *) echo "无效选项，请重试。" >&2 ;;
        esac
    done
}

select_scope() {
    echo "" >&2
    echo "请选择影响范围：" >&2
    local options=(
        "core     - 核心业务逻辑"
        "ui       - UI / 展示层"
        "api      - API / 网络层"
        "data     - 数据层 / 本地存储"
        "infra    - 构建 / CI / 配置 / 认证"
        "texttool - 文本更新 / 文案优化"
        "other    - 手动输入（项目业务模块 / 功能模块 / 自定义范围）"
    )
    PS3="请输入数字选择范围 [1-7]："
    select _ in "${options[@]}"; do
        case $REPLY in
            1) echo "core";     break ;;
            2) echo "ui";       break ;;
            3) echo "api";      break ;;
            4) echo "data";     break ;;
            5) echo "infra";    break ;;
            6) echo "texttool"; break ;;
            7)
                echo "" >&2
                echo "请输入自定义范围（如业务模块名、功能名等）：" >&2
                read -re custom_scope || { echo "" >&2; echo "已取消提交。" >&2; exit 1; }
                echo "$custom_scope"
                break
                ;;
            "") echo "" >&2; echo "已取消提交。" >&2; exit 1 ;;
            *)  echo "无效选项，请重试。" >&2 ;;
        esac
    done
}

get_subject() {
    echo "" >&2
    echo "请输入提交描述（优先中文，专业术语保留英文，祈使句，不加句号，最多 72 字符）：" >&2
    read -re subject || { echo "" >&2; echo "已取消提交。" >&2; exit 1; }
    echo "$subject"
}

type_name=$(select_type)
scope=$(select_scope)
subject=$(get_subject)

echo "$type_name($scope): $subject" > "$COMMIT_MSG_FILE"
echo "" >&2
echo "提交信息已保存。" >&2
